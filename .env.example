# ---------------------------------------------------------------------------
# NIAGARA ERP - Environment Configuration
# Copy this file to `.env` and fill in the values from your Supabase project.
# NEVER commit the real `.env` file. All values below are server-side only.
# ---------------------------------------------------------------------------

# Runtime connection (used by the Next.js server / Prisma Client).
# Supabase: use the Transaction pooler string (port 6543) for serverless
# deployments, or the Session pooler string (port 5432) for long-lived servers.
DATABASE_URL=""

# Migration / direct connection (used by the Prisma CLI only).
# Supabase: use the Session pooler or direct connection string (port 5432).
DIRECT_URL=""

# Auth.js secret. Generate with: npx auth secret  (or `openssl rand -base64 32`)
AUTH_SECRET=""
